{
  "name": "@agent-evals/runner",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./case-child": "./src/caseChild.ts",
    "./run-child": "./src/runChild.ts"
  },
  "tsdown": {
    "clean": true,
    "deps": {
      "alwaysBundle": [
        "@agent-evals/sdk",
        "@agent-evals/shared"
      ]
    },
    "dts": {
      "eager": true,
      "tsconfig": "tsconfig.build.json"
    },
    "entry": [
      "src/index.ts",
      "src/caseChild.ts",
      "src/runChild.ts"
    ],
    "format": "esm",
    "platform": "node"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsgo --noEmit",
    "lint": "tsgo --noEmit && eslint .",
    "eslint": "eslint ."
  },
  "dependencies": {
    "@agent-evals/shared": "workspace:*",
    "@agent-evals/sdk": "workspace:*",
    "@ls-stack/utils": "^3.77.0",
    "chokidar": "^4.0.3",
    "dayjs": "^1.11.20",
    "glob": "^11.0.2",
    "t-result": "^0.6.1",
    "vitest": "^3.2.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.2"
  }
}
