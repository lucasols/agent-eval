{
  "name": "@agent-evals/sdk",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "tsdown": {
    "clean": true,
    "deps": {
      "alwaysBundle": [
        "@agent-evals/shared"
      ]
    },
    "dts": {
      "eager": true
    },
    "entry": "src/index.ts",
    "format": "esm",
    "platform": "node"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsgo --noEmit",
    "lint": "tsgo --noEmit && eslint .",
    "eslint": "eslint ."
  },
  "dependencies": {
    "@agent-evals/shared": "workspace:*",
    "@ls-stack/utils": "^3.58.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^5.9.2"
  }
}
