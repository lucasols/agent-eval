{
  "name": "agent-evals",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:app": "node ./scripts/dev-app.mjs",
    "dev:server": "node ./scripts/dev-server.mjs",
    "dev:web": "pnpm --filter @agent-evals/web dev",
    "dev:all": "node ./scripts/dev.mjs",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @agent-evals/web build",
    "build:server": "pnpm --filter @agent-evals/server build",
    "tsc": "pnpm -r tsc",
    "lint": "pnpm -r lint",
    "eslint": "pnpm -r eslint",
    "format": "oxfmt .",
    "publish:pkg": "pkg-manager publish @ls-stack/agent-eval",
    "hooks:install": "simple-git-hooks",
    "hooks:uninstall": "git config --unset core.hooksPath || true && rm -rf .git/hooks/pre-commit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ls-stack/extended-lint": "^0.89.6",
    "@ls-stack/pkg-manager": "^0.8.0",
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "7.0.0-dev.20260614.1",
    "eslint": "^9.39.4",
    "eslint-plugin-unicorn": "^65.0.1",
    "jiti": "^2.7.0",
    "oxfmt": "^0.54.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "packageManager": "pnpm@11.7.0",
  "simple-git-hooks": {
    "pre-commit": "node --no-warnings scripts/preCommitHook.ts"
  }
}
