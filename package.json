{
  "name": "agent-evals",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:app": "node ./scripts/dev-app.mjs",
    "dev:server": "node ./scripts/dev-server.mjs",
    "dev:web": "pnpm --filter @agent-evals/web dev",
    "dev:all": "node ./scripts/dev.mjs",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @agent-evals/web build",
    "build:server": "pnpm --filter @agent-evals/server build",
    "tsc": "pnpm -r tsc",
    "lint": "pnpm -r lint",
    "eslint": "pnpm -r eslint",
    "format": "oxfmt .",
    "hooks:install": "simple-git-hooks",
    "hooks:uninstall": "git config --unset core.hooksPath || true && rm -rf .git/hooks/pre-commit"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@ls-stack/extended-lint": "^0.76.1",
    "@types/node": "^24.12.0",
    "@typescript/native-preview": "7.0.0-dev.20260414.1",
    "eslint": "^9.36.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "jiti": "^2.6.1",
    "oxfmt": "^0.40.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  },
  "packageManager": "pnpm@10.12.1",
  "simple-git-hooks": {
    "pre-commit": "node --no-warnings scripts/preCommitHook.ts"
  }
}
