{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "paths": { "#src/*": ["./src/*"], "#server/*": ["../server/src/*"] }
  },
  "include": ["src"]
}
